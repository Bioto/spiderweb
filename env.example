# Spiderweb Configuration
# Copy this file to .env and customize for your environment

# Chunking Settings
SPIDERWEB_DEFAULT_CHUNKER=sliding_window
SPIDERWEB_DEFAULT_CHUNK_SIZE=1000
SPIDERWEB_DEFAULT_CHUNK_OVERLAP=200

# Embedding Settings (uses gluellm)
SPIDERWEB_EMBEDDING_MODEL=openai/text-embedding-3-small
SPIDERWEB_EMBEDDING_DIMENSION=1536

# Vector Store Settings
SPIDERWEB_DEFAULT_VECTOR_STORE=memory
SPIDERWEB_QDRANT_HOST=localhost
SPIDERWEB_QDRANT_PORT=6333
SPIDERWEB_QDRANT_API_KEY=
SPIDERWEB_DEFAULT_COLLECTION_NAME=spiderweb_documents

# Validation Settings
SPIDERWEB_ENABLE_VALIDATION=true
SPIDERWEB_MIN_CHUNK_QUALITY_SCORE=0.3
SPIDERWEB_DEDUPLICATION_THRESHOLD=0.95
SPIDERWEB_ENABLE_LLM_VALIDATION=false

# Batch Processing Settings
SPIDERWEB_MAX_CONCURRENT_EXTRACTIONS=5
SPIDERWEB_MAX_CONCURRENT_EMBEDDINGS=10
SPIDERWEB_BATCH_SIZE=100

# Extraction Settings
SPIDERWEB_DEFAULT_EXTRACTION_METHOD=markitdown
SPIDERWEB_ENABLE_CROSS_EXTRACTION=false

# Logging Settings
SPIDERWEB_LOG_LEVEL=INFO
SPIDERWEB_LOG_FILE_LEVEL=DEBUG
SPIDERWEB_LOG_DIR=logs
SPIDERWEB_LOG_FILE_NAME=spiderweb.log
SPIDERWEB_LOG_JSON_FORMAT=false
SPIDERWEB_LOG_CONSOLE_OUTPUT=true

# Storage Settings
SPIDERWEB_CACHE_DIR=.spiderweb_cache
SPIDERWEB_ENABLE_CACHE=true

# Search Settings
SPIDERWEB_DEFAULT_SEARCH_PROVIDER=duckduckgo
SPIDERWEB_DEFAULT_SEARCH_LIMIT=10

# Crawler Settings
SPIDERWEB_DEFAULT_CRAWLER_PROVIDER=crawl4ai
SPIDERWEB_DEFAULT_CRAWLER_DELAY=1.0
SPIDERWEB_DEFAULT_CRAWLER_TIMEOUT=30
SPIDERWEB_DEFAULT_CRAWLER_WAIT_FOR_JS=true
SPIDERWEB_DEFAULT_CRAWLER_MAX_CONCURRENT=5

# X (Twitter) API - for crawler provider "x" (pay-per-request)
SPIDERWEB_X_BEARER_TOKEN=

# Search Depth Settings
SPIDERWEB_DEFAULT_MAX_SEARCH_ROUNDS=1
SPIDERWEB_DEFAULT_CRAWL_PER_ROUND=3
SPIDERWEB_DEFAULT_WHEN_TO_GO_DEEPER=always
SPIDERWEB_DEFAULT_NUM_EXPANDED_QUERIES=2

# Save Defaults
SPIDERWEB_DEFAULT_SAVE_FORMAT=all
SPIDERWEB_DEFAULT_TRACE_FORMAT=json

# OpenAI API Key (required for embeddings via gluellm)
OPENAI_API_KEY=your_openai_api_key_here
